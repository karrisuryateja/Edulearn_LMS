          bootstrap.Modal.getInstance(document.getElementById('editCourseModal')).hide();
          showAllCourses();
          showCourses();
          alert('Course updated successfully!');
        })
        .catch(error => {
          hideLoading('editCourseForm', 'editCourseFormLoading');
          console.error('Error:', error);
          alert('Failed to update course.');
        });
      } else {
        // Update course without media
        fetch(`${API_BASE_URL}/courses/${courseId}`, {
          method: 'PUT',
          headers: {
            'Content-Type': 'application/json',
            'Authorization': `Bearer ${authToken}`
          },
          body: JSON.stringify({ title, description, duration, video })
        })
        .then(response => response.json())
        .then(course => {
          hideLoading('editCourseForm', 'editCourseFormLoading');
          // Close modal and refresh courses
          const editCourseModal = document.getElementById('editCourseModal');
          const editCourseModalInstance = bootstrap.Modal.getInstance(editCourseModal);
          if (editCourseModalInstance) {
            editCourseModalInstance.hide();
          }
          showAllCourses();
          showCourses();
          alert('Course updated successfully!');
        })
        .catch(error => {
