    // Load selected course forum
        return response.json();
      })
      .then(leaderboard => {
        console.log('Leaderboard data:', leaderboard);
        
        if (!leaderboard || leaderboard.length === 0) {
          document.getElementById('facultyLeaderboardContent').innerHTML = '\
            <div class="card text-center p-5">\
              <div class="mb-3">\
                <i class="bi bi-trophy" style="font-size: 3rem; color: #ffc107;"></i>\
              </div>\
              <h5>No Leaderboard Data</h5>\
              <p class="text-muted">No graded submissions found for this course yet</p>\
            </div>\
          ';
          return;
        }
        
        // Generate leaderboard table
        let leaderboardHtml = '\
          <div class="card">\
            <div class="card-header bg-primary text-white">\
              <h5 class="mb-0"><i class="bi bi-trophy me-2"></i>Course Leaderboard</h5>\
            </div>\
            <div class="card-body">\
              <div class="table-responsive">\
                <table class="table table-striped table-hover">\
                  <thead class="table-dark">\
                    <tr>\
                      <th scope="col">Rank</th>\
                      <th scope="col">Student</th>\
                      <th scope="col">Score</th>\
                      <th scope="col">Assignment</th>\
                      <th scope="col">Submission Date</th>\
                    </tr>\
                  </thead>\
                  <tbody>\
        ';
        
        leaderboard.forEach((entry, index) => {
          // Determine medal color based on rank
          let medal = '';
          if (entry.rank === 1) {
            medal = '<i class="bi bi-trophy-fill text-warning me-1"></i>';
          } else if (entry.rank === 2) {
            medal = '<i class="bi bi-trophy-fill text-secondary me-1"></i>';
          } else if (entry.rank === 3) {
            medal = '<i class="bi bi-trophy-fill text-danger me-1"></i>';
          }
          
          // Get profile photo or default
          const profilePhotoUrl = entry.studentProfilePhoto || 'https://cdn-icons-png.flaticon.com/512/149/149071.png';
          
          leaderboardHtml += '\
            <tr>\
              <td>' + medal + entry.rank + '</td>\
              <td>\
                <div class="d-flex align-items-center">\
                  <img src="' + profilePhotoUrl + '" alt="Profile" class="rounded-circle me-2" style="width: 30px; height: 30px; object-fit: cover;">\
                  <span>' + entry.studentName + '</span>\
                </div>\
              </td>\
              <td><span class="badge bg-success">' + entry.score + '/100</span></td>\
              <td>' + entry.assignmentTitle + '</td>\
              <td>' + new Date(entry.submissionDate).toLocaleString() + '</td>\
            </tr>\
          ';
        });
        
        leaderboardHtml += '\
                  </tbody>\
                </table>\
              </div>\
            </div>\
          </div>\
        ';
        
        document.getElementById('facultyLeaderboardContent').innerHTML = leaderboardHtml;
      })
      .catch(error => {
        console.error('Error loading leaderboard:', error);
        document.getElementById('facultyLeaderboardContent').innerHTML = '\
          <div class="card text-center p-5">\
            <div class="mb-3">\
              <i class="bi bi-exclamation-triangle-fill" style="font-size: 3rem; color: #dc3545;"></i>\
            </div>\
            <h5>Leaderboard Unavailable</h5>\
            <p class="text-danger">Error: ' + error.message + '</p>\
            <button class="btn btn-primary" onclick="loadFacultyLeaderboard()">\
              <i class="bi bi-arrow-repeat me-1"></i>Retry\
            </button>\
          </div>\
        ';
      });
    }

    // View enrollments for a course
    function viewEnrollments(courseId) {
      // Fetch enrollments from the backend
      fetch(API_BASE_URL + '/enrollments/course/' + courseId, {
        headers: {
          'Authorization': 'Bearer ' + authToken
        }
      })
      .then(response => response.json())
      .then(enrollments => {
        // Create a modal to display enrollments
        let modalHtml = `
          <div class="modal fade" id="enrollmentsModal" tabindex="-1" aria-labelledby="enrollmentsModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-lg">
              <div class="modal-content">
                <div class="modal-header">
                  <h5 class="modal-title" id="enrollmentsModalLabel">Enrolled Students</h5>
                  <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                  <div class="table-responsive">
                    <table class="table table-striped">
                      <thead>
                        <tr>
                          <th>Student</th>
                          <th>Email</th>
                          <th>Enrollment Date</th>
                          <th>Streak</th>
                        </tr>
                      </thead>
                      <tbody>
        `;
        
        if (enrollments.length === 0) {
          modalHtml += `
            <tr>
              <td colspan="4" class="text-center">No students enrolled yet.</td>
            </tr>
          `;
        } else {
          enrollments.forEach(function(enrollment, index) {
            // Get profile photo or default
            const profilePhotoUrl = enrollment.student.profilePhoto || 'https://cdn-icons-png.flaticon.com/512/149/149071.png';
            
            modalHtml += `
              <tr>
                <td>
                  <div class="d-flex align-items-center">
                    <img src="${profilePhotoUrl}" alt="Profile" class="rounded-circle me-2" style="width: 30px; height: 30px; object-fit: cover;">
                    <span>${enrollment.student.name}</span>
                  </div>
                </td>
                <td>${enrollment.student.email}</td>
                <td>${new Date(enrollment.createdAt).toLocaleDateString()}</td>
                <td>${enrollment.streak || 0} days</td>
              </tr>
            `;
          });
        }
        
        modalHtml += `
                      </tbody>
                    </table>
                  </div>
                </div>
                <div class="modal-footer">
                  <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                </div>
              </div>
            </div>
          </div>
        `;
        
        // Add modal to body
        if (document.getElementById('enrollmentsModal')) {
          document.getElementById('enrollmentsModal').remove();
        }
        document.body.insertAdjacentHTML('beforeend', modalHtml);
        
        // Show the modal
        new bootstrap.Modal(document.getElementById('enrollmentsModal')).show();
        
        // Remove modal from DOM when closed
        document.getElementById('enrollmentsModal').addEventListener('hidden.bs.modal', function () {
          document.getElementById('enrollmentsModal').remove();
        });
      })
      .catch(function(error) {
        console.error('Error fetching enrollments:', error);
        alert('Failed to fetch enrollments: ' + error.message);
      });
    }

        // Pre-fill the assignment form with existing data
        document.getElementById('assignmentModalLabel').textContent = 'Edit Assignment';
        document.getElementById('assignmentCourseId').value = assignment.course._id;
        document.getElementById('assignmentTitle').value = assignment.title;
        document.getElementById('assignmentDescription').value = assignment.description;
        document.getElementById('assignmentDueDate').value = assignment.dueDate.split('T')[0]; // Format date
        
        // Set AI grading fields
        document.getElementById('enableAIGrading').checked = assignment.enableAIGrading;
        document.getElementById('sampleSolution').value = assignment.sampleSolution || '';
        document.getElementById('gradingCriteria').value = assignment.gradingCriteria || '';
        
        // Show the form and hide submissions section
        document.getElementById('assignmentForm').style.display = 'block';
        document.getElementById('submissionsDivider').style.display = 'none';
        document.getElementById('submissionsHeading').style.display = 'none';
        document.getElementById('submissionsList').innerHTML = '';
        
        // Add a hidden field to track we're editing
        let hiddenIdField = document.getElementById('editingAssignmentId');
        if (!hiddenIdField) {
          hiddenIdField = document.createElement('input');
          hiddenIdField.type = 'hidden';
          hiddenIdField.id = 'editingAssignmentId';
          document.getElementById('assignmentForm').appendChild(hiddenIdField);
        }
        hiddenIdField.value = assignmentId;
        
        // Show the modal
        new bootstrap.Modal(document.getElementById('assignmentModal')).show();
      })
      .catch(error => {
        console.error('Error loading assignment:', error);
        alert('Failed to load assignment details.');
      });
    }

    // View submissions for an assignment
    function viewSubmissions(assignmentId) {
      // Debug: Log the assignment ID to console
      console.log('Viewing submissions for assignment ID:', assignmentId);
      
      // Validate assignmentId
      if (!assignmentId) {
        console.error('Invalid assignment ID');
        return;
      }
      
      // Update modal to submissions view mode
      document.getElementById('assignmentModalLabel').textContent = 'Assignment Submissions';
      document.getElementById('assignmentForm').style.display = 'none';
      document.getElementById('submissionsDivider').style.display = 'block';
      document.getElementById('submissionsHeading').style.display = 'block';
      
      // Show loading indicator
      document.getElementById('submissionsList').innerHTML = `
        <div class="text-center">
          <div class="spinner-border" role="status">
            <span class="visually-hidden">Loading...</span>
          </div>
        </div>
      `;
      
      // Show the modal
      const modal = new bootstrap.Modal(document.getElementById('assignmentModal'));
      modal.show();
      
      // Check if authToken exists
      if (!authToken) {
        console.error('No auth token found');
        document.getElementById('submissionsList').innerHTML = '<p class="text-danger">Authentication error. Please log in again.</p>';
        return;
      }
      
      // Fetch and display submissions
      fetch(`${API_BASE_URL}/submissions/assignment/${assignmentId}`, {
        headers: {
          'Authorization': `Bearer ${authToken}`
        }
      })
      .then(response => {
        console.log('Response status:', response.status);
        if (!response.ok) {
          throw new Error(`HTTP error! status: ${response.status}`);
        }
        return response.json();
      })
      .then(submissions => {
        console.log('Submissions data:', submissions);
        let submissionsHtml = '';
        if (!submissions || submissions.length === 0) {
          submissionsHtml = '<p class="text-muted">No submissions yet.</p>';
        } else {
          submissionsHtml = '<div class="table-responsive"><table class="table table-striped"><thead><tr><th>Student</th><th>Submission Date</th><th>Submission</th><th>Status</th><th>Action</th></tr></thead><tbody>';
          
          submissions.forEach(submission => {
            // Ensure student object exists
            const studentName = submission.student && submission.student.name ? submission.student.name : 'Unknown Student';
            const submissionText = submission.submissionText || 'No submission text';
            
            submissionsHtml += `
              <tr>
                <td>${studentName}</td>
                <td>${new Date(submission.createdAt).toLocaleDateString()}</td>
                <td><button class="btn btn-sm btn-outline-info" onclick="showSubmissionText('${submission._id}')">View</button></td>
                <td>${submission.grade && submission.grade.score !== undefined ? (submission.grade.isAIGrade ? 'AI Graded' : 'Graded') : 'Pending'}</td>
                <td>
                  ${submission.grade && submission.grade.score !== undefined ? 
                    `<div class="d-flex flex-column align-items-start">
                      <span class="badge bg-success mb-1">${submission.grade.score}/100</span>
                      ${submission.grade.isAIGrade ? 
                        `<div class="btn-group btn-group-sm" role="group">
                          <button class="btn btn-outline-primary" onclick="reEvaluateSubmission('${submission._id}', '${assignmentId}')">Re-evaluate</button>
                        </div>` : 
                        `<div class="btn-group btn-group-sm" role="group">
                          <button class="btn btn-outline-success" onclick="aiGradeSubmission('${submission._id}', '${assignmentId}')">AI Grade</button>
                        </div>`
                      }
                    </div>` :
                    `<div class="btn-group" role="group">
                      <button class="btn btn-sm btn-primary" onclick="openGradeModal('${submission._id}')">Manual Grade</button>
                      <button class="btn btn-sm btn-success" onclick="aiGradeSubmission('${submission._id}', '${assignmentId}')">AI Grade</button>
                    </div>`
                  }
                </td>
              </tr>
            `;
          });
          
          submissionsHtml += '</tbody></table></div>';
          
          // Add hidden divs to store submission texts
          submissionsHtml += '<div id="submissionTexts" style="display:none;">';
          submissions.forEach(submission => {
            submissionsHtml += `<div id="submission-${submission._id}">${submission.submissionText || 'No submission text'}</div>`;
          });
          submissionsHtml += '</div>';
        }
        
        document.getElementById('submissionsList').innerHTML = submissionsHtml;
      })
      .catch(error => {
        console.error('Error fetching submissions:', error);
        document.getElementById('submissionsList').innerHTML = `<p class="text-danger">Failed to load submissions: ${error.message}</p>`;
      });
    }

    // AI Grade submission
    function aiGradeSubmission(submissionId, assignmentId) {
      // Confirm with user before AI grading
      if (!confirm('Are you sure you want to grade this submission with AI? This will automatically assign a score based on the sample solution.')) {
        return;
      }
      
      fetch(`${API_BASE_URL}/submissions/${submissionId}/ai-grade`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Authorization': `Bearer ${authToken}`
        }
      })
      .then(response => {
        // Check if response is OK before trying to parse JSON
        if (!response.ok) {
          return response.text().then(text => {
            // Try to parse as JSON, but if it fails, return the text
            try {
              return JSON.parse(text);
            } catch (e) {
              // If it's not JSON, it might be an HTML error page
              throw new Error(`HTTP ${response.status}: ${text.substring(0, 100)}...`);
            }
          }).then(err => { throw new Error(err.message || 'Unknown error'); });
        }
        return response.json();
      })
      .then(data => {
        const score = data.submission.grade && data.submission.grade.score !== undefined ? data.submission.grade.score : 'N/A';
        alert(`Submission AI graded successfully!\nScore: ${score}/100`);
        // Refresh submissions
        viewSubmissions(assignmentId);
      })
      .catch(error => {
        console.error('Error AI grading submission:', error);
        alert(`Failed to AI grade submission: ${error.message}`);
      });
    }

    // Re-evaluate submission with AI
    function reEvaluateSubmission(submissionId, assignmentId) {
      // Confirm with user before re-evaluating
      if (!confirm('Are you sure you want to re-evaluate this submission with AI? This will overwrite the current AI grade.')) {
        return;
      }
      
      fetch(`${API_BASE_URL}/submissions/${submissionId}/ai-grade`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Authorization': `Bearer ${authToken}`
        }
      })
      .then(response => {
        // Check if response is OK before trying to parse JSON
        if (!response.ok) {
          return response.text().then(text => {
            // Try to parse as JSON, but if it fails, return the text
            try {
              return JSON.parse(text);
            } catch (e) {
              // If it's not JSON, it might be an HTML error page
              throw new Error(`HTTP ${response.status}: ${text.substring(0, 100)}...`);
            }
          }).then(err => { throw new Error(err.message || 'Unknown error'); });
        }
        return response.json();
      })
      .then(data => {
        const score = data.submission.grade && data.submission.grade.score !== undefined ? data.submission.grade.score : 'N/A';
        alert(`Submission re-evaluated successfully!\nScore: ${score}/100`);
        // Refresh submissions
        viewSubmissions(assignmentId);
      })
      .catch(error => {
        console.error('Error re-evaluating submission:', error);
        alert(`Failed to re-evaluate submission: ${error.message}`);
      });
    }

    // Show submission text in a modal
    function showSubmissionText(submissionId) {
      // First, remove any existing submission text modals to prevent duplicates
      const existingModal = document.getElementById('submissionTextModal');
      if (existingModal) {
        // If there's an existing modal, properly dispose of it using Bootstrap's modal instance
        const modalInstance = bootstrap.Modal.getInstance(existingModal);
        if (modalInstance) {
          modalInstance.dispose();
        }
        existingModal.remove();
      }
      
      const submissionText = document.getElementById(`submission-${submissionId}`).textContent;
      
      // Create a modal for displaying submission text
      const modalHtml = `
        <div class="modal fade" id="submissionTextModal" tabindex="-1" aria-labelledby="submissionTextModalLabel" aria-hidden="true">
          <div class="modal-dialog modal-lg">
            <div class="modal-content">
              <div class="modal-header">
                <h5 class="modal-title" id="submissionTextModalLabel">Student Submission</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
              </div>
              <div class="modal-body">
                <pre style="white-space: pre-wrap;">${submissionText}</pre>
              </div>
              <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
              </div>
            </div>
          </div>
        </div>
      `;
      
      // Add modal to body
      document.body.insertAdjacentHTML('beforeend', modalHtml);
      
      // Get the newly created modal element
      const modalElement = document.getElementById('submissionTextModal');
      
      // Show the modal
      const modal = new bootstrap.Modal(modalElement);
      modal.show();
      
      // Ensure proper cleanup when modal is hidden
      modalElement.addEventListener('hidden.bs.modal', function () {
        // Dispose of the modal instance to free up memory
        const modalInstance = bootstrap.Modal.getInstance(modalElement);
        if (modalInstance) {
          modalInstance.dispose();
        }
        // Remove the modal element from the DOM
        modalElement.remove();
      });
    }

    // Open assignment modal
    function openAssignmentModal(courseId) {
      // Reset modal to create assignment mode
      document.getElementById('assignmentModalLabel').textContent = 'Create Assignment';
      document.getElementById('assignmentForm').style.display = 'block';
      document.getElementById('submissionsDivider').style.display = 'block';
      document.getElementById('submissionsHeading').style.display = 'block';
      
      document.getElementById('assignmentCourseId').value = courseId;
      document.getElementById('assignmentForm').reset();
      document.getElementById('submissionsList').innerHTML = '<p class="text-muted">No submissions to display.</p>';
      new bootstrap.Modal(document.getElementById('assignmentModal')).show();
    }

    // Open grade modal
    function openGradeModal(submissionId) {
      document.getElementById('gradeSubmissionId').value = submissionId;
      document.getElementById('gradeForm').reset();
      // Hide assignment modal and show grade modal
      const assignmentModal = document.getElementById('assignmentModal');
      const assignmentModalInstance = bootstrap.Modal.getInstance(assignmentModal);
      if (assignmentModalInstance) {
        assignmentModalInstance.hide();
      }
      new bootstrap.Modal(document.getElementById('gradeModal')).show();
    }

    // Open forum modal
    function openForumModal(courseId) {
      document.getElementById('forumCourseId').value = courseId;
      document.getElementById('forumPostTitle').value = '';
      document.getElementById('forumPostContent').value = '';
      new bootstrap.Modal(document.getElementById('forumModal')).show();
      loadForumPosts(courseId);
    }

    // Open materials modal
    function openMaterialsModal(courseId) {
      document.getElementById('materialsCourseId').value = courseId;
      document.getElementById('materialTitle').value = '';
      document.getElementById('materialFile').value = '';
      new bootstrap.Modal(document.getElementById('materialsModal')).show();
      loadMaterials(courseId);
    }

    // Open edit course modal
    function openEditCourseModal(courseId) {
      // Fetch course details
      fetch(`${API_BASE_URL}/courses/${courseId}`, {
        headers: {
          'Authorization': `Bearer ${authToken}`
        }
      })
      .then(response => response.json())
      .then(course => {
        // Populate form with course data
        document.getElementById('editCourseId').value = course._id;
        document.getElementById('editCourseTitle').value = course.title;
        document.getElementById('editCourseDesc').value = course.description;
        document.getElementById('editCourseDuration').value = course.duration;
        document.getElementById('editCourseVideo').value = course.video || '';
        
        // Clear media input
        document.getElementById('editCourseMedia').value = '';
        
        // Show modal
        new bootstrap.Modal(document.getElementById('editCourseModal')).show();
      })
      .catch(error => {
        console.error('Error fetching course:', error);
        alert('Failed to load course details.');
      });
    }

    // Load forum posts
    function loadForumPosts(courseId) {
      // In a real implementation, this would fetch from the backend
      // For now, we'll simulate with localStorage
      const forumPosts = JSON.parse(localStorage.getItem(`forumPosts_${courseId}`)) || [];
      const forumPostsList = document.getElementById('forumPostsList');
      
      if (forumPosts.length === 0) {
        forumPostsList.innerHTML = `
          <div class="text-center p-4">
            <i class="bi bi-chat-dots" style="font-size: 3rem; color: #6c757d;"></i>
            <h5 class="mt-3">No discussion posts yet</h5>
            <p class="text-muted">Be the first to start a discussion in this course</p>
          </div>
        `;
        return;
      }
      
      let postsHtml = '<div class="list-group">';
      forumPosts.forEach(post => {
        postsHtml += `
          <div class="list-group-item">
            <div class="d-flex justify-content-between">
              <h6><i class="bi bi-chat-square-text me-2 text-primary"></i>${post.title}</h6>
              <small class="text-muted">${new Date(post.date).toLocaleString()}</small>
            </div>
            <p class="mb-2">${post.content}</p>
          </div>
        `;
      });
      postsHtml += '</div>';
      forumPostsList.innerHTML = postsHtml;
    }

    // View enrollments for a course
    function viewEnrollments(courseId) {
      // Fetch enrollments from the backend
      fetch(API_BASE_URL + '/enrollments/course/' + courseId, {
        headers: {
          'Authorization': 'Bearer ' + authToken
        }
      })
      .then(response => response.json())
      .then(enrollments => {
        // Create a modal to display enrollments
        let modalHtml = `
          <div class="modal fade" id="enrollmentsModal" tabindex="-1" aria-labelledby="enrollmentsModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-lg">
              <div class="modal-content">
                <div class="modal-header">
                  <h5 class="modal-title" id="enrollmentsModalLabel">Enrolled Students</h5>
                  <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                  <div class="table-responsive">
                    <table class="table table-striped">
                      <thead>
                        <tr>
                          <th>Student</th>
                          <th>Email</th>
                          <th>Enrollment Date</th>
                          <th>Streak</th>
                        </tr>
                      </thead>
                      <tbody>
        `;
        
        if (enrollments.length === 0) {
          modalHtml += `
            <tr>
              <td colspan="4" class="text-center">No students enrolled yet.</td>
            </tr>
          `;
        } else {
          enrollments.forEach(function(enrollment, index) {
            // Get profile photo or default
            const profilePhotoUrl = enrollment.student.profilePhoto || 'https://cdn-icons-png.flaticon.com/512/149/149071.png';
            
            modalHtml += `
              <tr>
                <td>
                  <div class="d-flex align-items-center">
                    <img src="${profilePhotoUrl}" alt="Profile" class="rounded-circle me-2" style="width: 30px; height: 30px; object-fit: cover;">
                    <span>${enrollment.student.name}</span>
                  </div>
                </td>
                <td>${enrollment.student.email}</td>
                <td>${new Date(enrollment.createdAt).toLocaleDateString()}</td>
                <td>${enrollment.streak || 0} days</td>
              </tr>
            `;
          });
        }
        
        modalHtml += `
                      </tbody>
                    </table>
                  </div>
                </div>
                <div class="modal-footer">
                  <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                </div>
              </div>
            </div>
          </div>
        `;
        
        // Add modal to body
        if (document.getElementById('enrollmentsModal')) {
          document.getElementById('enrollmentsModal').remove();
        }
        document.body.insertAdjacentHTML('beforeend', modalHtml);
        
        // Show the modal
        new bootstrap.Modal(document.getElementById('enrollmentsModal')).show();
        
        // Remove modal from DOM when closed
        document.getElementById('enrollmentsModal').addEventListener('hidden.bs.modal', function () {
          document.getElementById('enrollmentsModal').remove();
        });
      })
      .catch(function(error) {
        console.error('Error fetching enrollments:', error);
        alert('Failed to fetch enrollments: ' + error.message);
      });
    }

    // Add forum post
    function addFacultyForumPost() {
      const courseId = document.getElementById('facultyForumCourseSelect').value;
      const title = document.getElementById('facultyForumPostTitle').value.trim();
      const content = document.getElementById('facultyForumPostContent').value.trim();
      
      if (!courseId) {
        alert('Please select a course first.');
        return;
      }
      
      if (!title || !content) {
        alert('Please enter both title and content for the post.');
        return;
      }
      
      // Get existing posts
      const forumPosts = JSON.parse(localStorage.getItem(`forumPosts_${courseId}`)) || [];
      
      // Add new post
      forumPosts.push({
        id: Date.now(),
        title: title,
        content: content,
        author: loggedInUser.name,
        date: new Date().toISOString()
      });
      
      // Save to localStorage
      localStorage.setItem(`forumPosts_${courseId}`, JSON.stringify(forumPosts));
      
      // Clear form
      document.getElementById('facultyForumPostTitle').value = '';
      document.getElementById('facultyForumPostContent').value = '';
      
      // Reload posts
      loadForumPosts(courseId);
      
      alert('Post added successfully!');
    }

    // Load materials
    function loadMaterials(courseId) {
      // Load materials from the backend API to ensure consistency
      fetch(`${API_BASE_URL}/courses/${courseId}`)
      .then(response => {
        if (!response.ok) {
          throw new Error(`HTTP error! status: ${response.status}`);
        }
        return response.json();
      })
      .then(course => {
        const materialsList = document.getElementById('materialsList');
        
        if (!course.materials || course.materials.length === 0) {
          materialsList.innerHTML = `
            <div class="text-center p-4">
              <i class="bi bi-folder" style="font-size: 3rem; color: #6c757d;"></i>
              <h5 class="mt-3">No materials uploaded yet</h5>
              <p class="text-muted">Upload course materials for your students</p>
            </div>
          `;
          return;
        }
        
        let materialsHtml = '<div class="list-group">';
        course.materials.forEach(material => {
          // Create download URL using the proper endpoint
          const downloadUrl = `${API_BASE_URL}/courses/download/${course._id}/${material._id}`;
          
          materialsHtml += `
            <div class="list-group-item d-flex justify-content-between align-items-center">
              <div>
                <h6><i class="bi bi-file-earmark me-2 text-primary"></i>${material.title}</h6>
                <p class="mb-1"><small class="text-muted"><i class="bi bi-person me-1"></i>Uploaded by ${loggedInUser.name}</small></p>
                <p class="mb-0"><small class="text-muted"><i class="bi bi-calendar me-1"></i>${new Date(material.uploadedAt || Date.now()).toLocaleDateString()}</small></p>
              </div>
              <a href="${downloadUrl}" class="btn btn-sm btn-outline-primary">
                <i class="bi bi-download me-1"></i>Download
              </a>
            </div>
          `;
        });
        materialsHtml += '</div>';
        
        materialsList.innerHTML = materialsHtml;
      })
      .catch(error => {
        console.error('Error loading materials from backend:', error);
        const materialsList = document.getElementById('materialsList');
        materialsList.innerHTML = `
          <div class="text-center p-4">
            <i class="bi bi-exclamation-triangle" style="font-size: 3rem; color: #dc3545;"></i>
            <h5 class="mt-3">Error loading materials</h5>
            <p class="text-danger">Failed to load materials: ${error.message}</p>
          </div>
        `;
      });
    }

