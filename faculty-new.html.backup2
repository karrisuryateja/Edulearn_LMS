    // Upload material (improved implementation)
    function uploadMaterial() {
      // Try to get courseId from the modal hidden input first, then from the select dropdown
      let courseId = document.getElementById('materialsCourseId').value;
      
      // If not found in modal, try to get from the select dropdown
      if (!courseId || courseId === '') {
        const selectElement = document.getElementById('materialsCourseSelect');
        if (selectElement) {
          courseId = selectElement.value;
        }
      }
      
      const title = document.getElementById('modalMaterialTitle').value.trim();
      const fileInput = document.getElementById('modalMaterialFile');
      
      // Detailed validation with specific error messages
      if (!courseId || courseId === '') {
        alert('Please select a course first.');
        return;
      }
      
      if (!title || title === '') {
        alert('Please enter a material title.');
        return;
      }
      
      // Handle file upload
      if (fileInput.files && fileInput.files.length > 0) {
        const file = fileInput.files[0];
        
        // Create FormData object
        const formData = new FormData();
        formData.append('title', title);
        formData.append('file', file);
        
        // Upload file using the backend API
        fetch(API_BASE_URL + '/courses/' + courseId + '/materials/upload', {
          method: 'POST',
          headers: {
            'Authorization': 'Bearer ' + authToken
          },
          body: formData
        })
        .then(response => {
          if (!response.ok) {
            // Try to get the error message from the response
            return response.text().then(text => {
              let errorMessage = 'HTTP error! status: ' + response.status;
              try {
                const errorObj = JSON.parse(text);
                errorMessage = errorObj.message || errorMessage;
              } catch (e) {
                // If parsing fails, use the raw text
                errorMessage = text || errorMessage;
              }
              throw new Error(errorMessage);
            });
          }
          return response.json();
        })
        .then(course => {
          // Clear form
          document.getElementById('modalMaterialTitle').value = '';
          document.getElementById('modalMaterialFile').value = '';
          
          // Reload materials
          loadMaterials(courseId);
          
          // Also refresh the course displays to show updated material counts
          showCourses();
          
          alert('Material uploaded successfully! Students can now download it directly.');
        })
        .catch(error => {
          console.error('Error uploading material:', error);
          alert('Failed to upload material.\\nError: ' + error.message);
        });
      } else {
        alert('Please select a file to upload.');
      }
    }

    // Load assignments for assignments tab
    function loadAllAssignments() {
      if (!checkAuth()) return;
      
      const assignmentsContainer = document.getElementById('assignmentsTabContent');
      assignmentsContainer.innerHTML = 
        '<div class="text-center">' +
        '  <div class="spinner-border" role="status">' +
        '    <span class="visually-hidden">Loading...</span>' +
        '  </div>' +
        '</div>';
      
      // First get all courses for this faculty
      fetch(API_BASE_URL + '/courses', {
        headers: {
          'Authorization': 'Bearer ' + authToken
        }
      })
      .then(response => response.json())
      .then(courses => {
        // Fixed the filtering logic - now correctly compares with the faculty ID
        const facultyCourses = courses.filter(course => {
          // Handle both cases where faculty might be an object or just an ID
          if (course.faculty && typeof course.faculty === 'object') {
            return course.faculty._id === loggedInUser.id;
          } else {
            return course.faculty === loggedInUser.id;
          }
        });
        const courseIds = facultyCourses.map(course => course._id);
        
        if (courseIds.length === 0) {
          assignmentsContainer.innerHTML = 
            '<div class="card text-center p-5">' +
            '  <div class="mb-3">' +
            '    <i class="bi bi-file-earmark-x" style="font-size: 3rem; color: #6c757d;"></i>' +
            '  </div>' +
            '  <h5>No assignments available</h5>' +
            '  <p class="text-muted">You haven\'t created any courses yet. Create a course first to add assignments.</p>' +
            '</div>';
          return;
        }
        
        // Get assignments for all courses
        const assignmentPromises = courseIds.map(courseId => 
          fetch(API_BASE_URL + '/assignments/course/' + courseId, {
            headers: {
              'Authorization': 'Bearer ' + authToken
            }
          }).then(response => response.json())
        );
        
        Promise.all(assignmentPromises)
          .then(allAssignments => {
            // Flatten the array of assignments
            const flattenedAssignments = [].concat(...allAssignments);
            
            if (flattenedAssignments.length === 0) {
              assignmentsContainer.innerHTML = 
                '<div class="card text-center p-5">' +
                '  <div class="mb-3">' +
                '    <i class="bi bi-file-earmark-x" style="font-size: 3rem; color: #6c757d;"></i>' +
                '  </div>' +
                '  <h5>No assignments created</h5>' +
                '  <p class="text-muted">You haven\'t created any assignments yet. Use the "Create Assignment" button in your courses.</p>' +
                '</div>';
              return;
            }
            
            // Group assignments by course
            const assignmentsByCourse = {};
            flattenedAssignments.forEach(assignment => {
              if (!assignmentsByCourse[assignment.courseId]) {
                assignmentsByCourse[assignment.courseId] = [];
              }
              assignmentsByCourse[assignment.courseId].push(assignment);
            });
            
            // Create HTML for assignments grouped by course
            let assignmentsHtml = '';
            facultyCourses.forEach(course => {
              if (assignmentsByCourse[course._id] && assignmentsByCourse[course._id].length > 0) {
                assignmentsHtml += 
                  '<div class="card mb-4">' +
                  '  <div class="card-header">' +
                  '    <h5 class="mb-0"><i class="bi bi-journal-text me-2"></i>' + course.title + '</h5>' +
                  '  </div>' +
                  '  <div class="card-body">';
                
                assignmentsByCourse[course._id].forEach(assignment => {
                  assignmentsHtml += 
                    '<div class="card assignment-card p-2 mb-2">' +
                    '  <div class="d-flex justify-content-between">' +
                    '    <div>' +
                    '      <strong>' + assignment.title + '</strong>' +
                    '      <p class="mb-1">' + assignment.description + '</p>' +
                    '      <small class="text-muted">Due: ' + new Date(assignment.dueDate).toLocaleDateString() + '</small>' +
                    '    </div>' +
                    '    <button class="btn btn-sm btn-outline-info" onclick="viewSubmissions(\'' + assignment._id + '\')">' +
                    '      <i class="bi bi-eye"></i> View Submissions' +
                    '    </button>' +
                    '  </div>' +
                    '</div>';
                });
                
                assignmentsHtml += 
                  '    </div>' +
                  '  </div>';
              }
            });
            
            assignmentsContainer.innerHTML = assignmentsHtml;
          })
          .catch(error => {
            console.error('Error loading assignments:', error);
            assignmentsContainer.innerHTML = 
              '<div class="card text-center p-5">' +
              '  <div class="mb-3">' +
              '    <i class="bi bi-exclamation-triangle-fill" style="font-size: 3rem; color: #dc3545;"></i>' +
              '  </div>' +
              '  <h5>Failed to load assignments</h5>' +
              '  <p class="text-danger">Error: ' + error.message + '</p>' +
              '</div>';
          });
      })
      .catch(error => {
        console.error('Error loading courses:', error);
        assignmentsContainer.innerHTML = 
          '<div class="card text-center p-5">' +
          '  <div class="mb-3">' +
          '    <i class="bi bi-exclamation-triangle-fill" style="font-size: 3rem; color: #dc3545;"></i>' +
          '  </div>' +
          '  <h5>Failed to load assignments</h5>' +
          '  <p class="text-danger">Error: ' + error.message + '</p>' +
          '</div>';
      });
    }

    // Load courses for forum and materials dropdowns
    function loadCoursesForDropdowns() {
      fetch(API_BASE_URL + '/courses', {
        headers: {
          'Authorization': 'Bearer ' + authToken
        }
      })
      .then(response => response.json())
      .then(courses => {
        // Fixed the filtering logic - now correctly compares with the faculty ID
        const facultyCourses = courses.filter(course => {
          // Handle both cases where faculty might be an object or just an ID
          if (course.faculty && typeof course.faculty === 'object') {
            return course.faculty._id === loggedInUser.id;
          } else {
            return course.faculty === loggedInUser.id;
          }
        });
        
        // Populate forum course select
        const forumSelect = document.getElementById('facultyForumCourseSelect');
        forumSelect.innerHTML = '<option value="">Select a course</option>';
        facultyCourses.forEach(course => {
          forumSelect.innerHTML += '<option value="' + course._id + '">' + course.title + '</option>';
        });
        
        // Populate materials course select
        const materialsSelect = document.getElementById('materialsCourseSelect');
        materialsSelect.innerHTML = '<option value="">Select a course</option>';
        facultyCourses.forEach(course => {
          materialsSelect.innerHTML += '<option value="' + course._id + '">' + course.title + '</option>';
        });
      })
      .catch(error => {
        console.error('Error loading courses for dropdowns:', error);
      });
    }

    // Load selected course forum
    function loadSelectedCourseForum() {
      const courseId = document.getElementById('facultyForumCourseSelect').value;
      if (!courseId) {
        document.getElementById('facultyForumPostsList').innerHTML = '<p class="text-muted">Please select a course to view discussion posts.</p>';
        return;
      }
      loadForumPosts(courseId);
    }

    // Add faculty forum post
    function addFacultyForumPost() {
      const courseId = document.getElementById('facultyForumCourseSelect').value;
      const title = document.getElementById('facultyForumPostTitle').value.trim();
      const content = document.getElementById('facultyForumPostContent').value.trim();
      
      if (!courseId) {
        alert('Please select a course first.');
        return;
      }
      
      if (!title || !content) {
        alert('Please enter both title and content for the post.');
        return;
      }
      
      // Get existing posts
      const forumPosts = JSON.parse(localStorage.getItem('forumPosts_' + courseId)) || [];
      
      // Add new post
      forumPosts.push({
        id: Date.now(),
        title: title,
        content: content,
        author: loggedInUser.name,
        date: new Date().toISOString()
      });
      
      // Save to localStorage
      localStorage.setItem('forumPosts_' + courseId, JSON.stringify(forumPosts));
      
      // Clear form
      document.getElementById('facultyForumPostTitle').value = '';
      document.getElementById('facultyForumPostContent').value = '';
      
      // Reload posts
      loadForumPosts(courseId);
      
      alert('Post added successfully!');
    }

    // Load selected course materials
    function loadSelectedCourseMaterials() {
      const courseId = document.getElementById('materialsCourseSelect').value;
      if (!courseId) {
        document.getElementById('materialsList').innerHTML = '<p class="text-muted">Please select a course to view materials.</p>';
        return;
      }
      loadMaterials(courseId);
    }

    // Function to load faculty statistics
    function loadFacultyStatistics() {
      if (!authToken) return;
      
      // Fetch all courses for this faculty
      fetch(API_BASE_URL + '/courses', {
        headers: {
          'Authorization': 'Bearer ' + authToken
        }
      })
      .then(response => response.json())
      .then(courses => {
        // Filter courses for current faculty
        const facultyCourses = courses.filter(course => {
          // Handle both cases where faculty might be an object or just an ID
          if (course.faculty && typeof course.faculty === 'object') {
            return course.faculty._id === loggedInUser.id;
          } else {
            return course.faculty === loggedInUser.id;
          }
        });
        const courseIds = facultyCourses.map(course => course._id);
        
        // If faculty has courses, fetch enrollments for each and count total enrolled students
        if (courseIds.length > 0) {
          // Fetch enrollments for all faculty courses
          const enrollmentPromises = courseIds.map(courseId => 
            fetch(API_BASE_URL + '/enrollments/course/' + courseId, {
              headers: {
                'Authorization': 'Bearer ' + authToken
              }
            }).then(response => response.json())
          );
          
          Promise.all(enrollmentPromises)
            .then(allEnrollments => {
              // Flatten the array of enrollments and count unique students
              const flattenedEnrollments = [].concat(...allEnrollments);
              const uniqueStudents = new Set(flattenedEnrollments.map(enrollment => enrollment.student._id));
              const totalEnrolled = uniqueStudents.size;
              
              // Update UI with statistics
              document.getElementById('enrolledStudentsCount').textContent = totalEnrolled;
              // For active students, we'll use the same count since we don't have activity data
              document.getElementById('activeStudentsCount').textContent = totalEnrolled;
            })
            .catch(error => {
              console.error('Error loading enrollments:', error);
              document.getElementById('enrolledStudentsCount').textContent = '0';
              document.getElementById('activeStudentsCount').textContent = '0';
            });
        } else {
          // No courses, so no enrolled students
          document.getElementById('enrolledStudentsCount').textContent = '0';
          document.getElementById('activeStudentsCount').textContent = '0';
        }
      })
      .catch(error => {
        console.error('Error loading faculty courses:', error);
        document.getElementById('enrolledStudentsCount').textContent = '0';
        document.getElementById('activeStudentsCount').textContent = '0';
      });
    }

    // Show loading state
    function showLoading(buttonId, loadingId) {
      const button = document.getElementById(buttonId);
      const loading = document.getElementById(loadingId);
      const buttonText = button.querySelector('.button-text');
      
      loading.style.display = 'inline-block';
      buttonText.style.display = 'none';
      button.disabled = true;
    }

    // Hide loading state
    function hideLoading(buttonId, loadingId) {
      const button = document.getElementById(buttonId);
      const loading = document.getElementById(loadingId);
      const buttonText = button.querySelector('.button-text');
      
      loading.style.display = 'none';
      buttonText.style.display = 'inline-block';
      button.disabled = false;
    }

    // On form submit - save new course
    document.getElementById('courseForm').addEventListener('submit', e => {
      e.preventDefault();
      const title = document.getElementById('courseTitle').value.trim();
      const description = document.getElementById('courseDesc').value.trim();
      const duration = document.getElementById('courseDuration').value.trim();
      const video = document.getElementById('courseVideo').value.trim();
      const mediaFile = document.getElementById('courseMedia').files[0];

      // Simple validation
      if (!title || !description || !duration) {
        alert('Please fill in all required fields.');
        return;
      }

      showLoading('courseForm', 'courseFormLoading');
      
      // Handle media upload if provided
      if (mediaFile) {
        // In a real implementation, you would upload the file to a server
        // and get a URL back. For now, we'll just create a temporary URL.
        const mediaUrl = URL.createObjectURL(mediaFile);
        
        // Create course with media as initial material
        fetch(`${API_BASE_URL}/courses`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Authorization': `Bearer ${authToken}`
          },
          body: JSON.stringify({ 
            title, 
            description, 
            duration, 
            video,
            materials: [{
              title: mediaFile.name,
              url: mediaUrl
            }]
          })
        })
        .then(response => response.json())
        .then(course => {
          hideLoading('courseForm', 'courseFormLoading');
          showCourses();
          document.getElementById('courseForm').reset();
        })
        .catch(error => {
          hideLoading('courseForm', 'courseFormLoading');
          console.error('Error:', error);
          alert('Failed to create course.');
        });
      } else {
        // Create course without media
        fetch(`${API_BASE_URL}/courses`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Authorization': `Bearer ${authToken}`
          },
          body: JSON.stringify({ title, description, duration, video })
        })
        .then(response => response.json())
        .then(course => {
          hideLoading('courseForm', 'courseFormLoading');
          showCourses();
          document.getElementById('courseForm').reset();
        })
        .catch(error => {
          hideLoading('courseForm', 'courseFormLoading');
          console.error('Error:', error);
          alert('Failed to create course.');
        });
      }
    });

    // Assignment form submit
    document.getElementById('assignmentForm').addEventListener('submit', e => {
      e.preventDefault();
      
      const editingAssignmentId = document.getElementById('editingAssignmentId')?.value;
      const courseId = document.getElementById('assignmentCourseId').value;
      const title = document.getElementById('assignmentTitle').value.trim();
      const description = document.getElementById('assignmentDescription').value.trim();
      const dueDate = document.getElementById('assignmentDueDate').value;
      
      // AI Grading fields
      const enableAIGrading = document.getElementById('enableAIGrading').checked;
      const sampleSolution = document.getElementById('sampleSolution').value.trim();
      const gradingCriteria = document.getElementById('gradingCriteria').value.trim();
      
      if (!title || !description || !dueDate) {
        alert('Please fill in all required fields.');
        return;
      }
      
      // If AI grading is enabled, sample solution is required
      if (enableAIGrading && !sampleSolution) {
        alert('Please provide a sample solution for AI grading.');
        return;
      }
      
      showLoading('assignmentForm', 'assignmentFormLoading');
      
      // Determine if we're creating or updating
      const isEditing = editingAssignmentId && editingAssignmentId !== '';
      const url = isEditing ? `${API_BASE_URL}/assignments/${editingAssignmentId}` : `${API_BASE_URL}/assignments`;
      const method = isEditing ? 'PUT' : 'POST';
      
      const requestData = isEditing ? 
        { title, description, dueDate, enableAIGrading, sampleSolution, gradingCriteria } : 
        { title, description, dueDate, courseId, enableAIGrading, sampleSolution, gradingCriteria };
      
      fetch(url, {
        method: method,
        headers: {
          'Content-Type': 'application/json',
          'Authorization': `Bearer ${authToken}`
        },
        body: JSON.stringify(requestData)
      })
      .then(response => response.json())
      .then(assignment => {
        hideLoading('assignmentForm', 'assignmentFormLoading');
        // Close modal and refresh courses
        bootstrap.Modal.getInstance(document.getElementById('assignmentModal')).hide();
        showCourses();
        
        // Add notification
        if (isEditing) {
          addNotification('Assignment Updated', `You have updated assignment: ${title}`);
        } else {
          addNotification('New Assignment Created', `You have created a new assignment: ${title}`);
        }
        
        // Clean up editing field
        const hiddenIdField = document.getElementById('editingAssignmentId');
        if (hiddenIdField) {
          hiddenIdField.remove();
        }
      })
      .catch(error => {
        hideLoading('assignmentForm', 'assignmentFormLoading');
        console.error('Error:', error);
        alert(isEditing ? 'Failed to update assignment.' : 'Failed to create assignment.');
      });
    });

    // Grade form submit
    document.getElementById('gradeForm').addEventListener('submit', e => {
      e.preventDefault();
      
      const submissionId = document.getElementById('gradeSubmissionId').value;
      const score = document.getElementById('gradeScore').value;
      const feedback = document.getElementById('gradeFeedback').value.trim();
      
      if (!score) {
        alert('Please enter a score.');
        return;
      }
      
      showLoading('gradeForm', 'gradeFormLoading');
      
      fetch(`${API_BASE_URL}/submissions/${submissionId}/grade`, {
        method: 'PUT',
        headers: {
          'Content-Type': 'application/json',
          'Authorization': `Bearer ${authToken}`
        },
        body: JSON.stringify({ score, feedback })
      })
      .then(response => response.json())
      .then(submission => {
        hideLoading('gradeForm', 'gradeFormLoading');
        // Close modal and refresh courses
        const gradeModal = document.getElementById('gradeModal');
        const gradeModalInstance = bootstrap.Modal.getInstance(gradeModal);
        if (gradeModalInstance) {
          gradeModalInstance.hide();
        }
        new bootstrap.Modal(document.getElementById('assignmentModal')).show();
        // We would need to refresh submissions here in a real app
        
        // Add notification about grading
        addNotification('Assignment Graded', `You have graded an assignment. Score: ${score}/100`);
      })
      .catch(error => {
        hideLoading('gradeForm', 'gradeFormLoading');
        console.error('Error:', error);
        alert('Failed to submit grade.');
      });
    });

    // Edit course form submit
    document.getElementById('editCourseForm').addEventListener('submit', e => {
      e.preventDefault();
      
      const courseId = document.getElementById('editCourseId').value;
      const title = document.getElementById('editCourseTitle').value.trim();
      const description = document.getElementById('editCourseDesc').value.trim();
      const duration = document.getElementById('editCourseDuration').value.trim();
